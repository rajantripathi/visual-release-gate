{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-release-gate/review.schema.json",
  "title": "Visual Release Gate review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "processing_status",
    "verdict",
    "summary",
    "issues",
    "unverifiable_checks",
    "blocking_reason",
    "telemetry"
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "processing_status": {
      "enum": ["completed", "input_error", "provider_error", "budget_stopped"]
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": ["ship", "reject", "human_review", "unsupported", null]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "unverifiable_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "blocking_reason": {"type": ["string", "null"]},
    "telemetry": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/telemetry"}
      ]
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "observation", "source_ids", "why_it_matters", "suggested_fix"],
      "properties": {
        "severity": {"enum": ["critical", "major", "minor"]},
        "observation": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "why_it_matters": {"type": "string", "minLength": 1},
        "suggested_fix": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "reason", "source_ids", "kind", "decision_critical"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "kind": {"enum": ["external_authority", "visual_ambiguity", "source_conflict", "other"]},
        "decision_critical": {"type": "boolean"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_profile", "attempts", "latency_ms", "cost_usd", "task_id", "usage", "finish_reason"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_profile": {"type": "string", "minLength": 1},
        "attempts": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "task_id": {"type": ["string", "null"]},
        "usage": {"type": "object"},
        "finish_reason": {"type": ["string", "null"]}
      }
    }
  }
}
